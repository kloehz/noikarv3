[netfox]

time/tickrate=30
rollback/history_limit=128
rollback/display_offset=1
logging/log_level=4

[noikar]

auth/api_url="http://72.60.58.24:8090"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"
